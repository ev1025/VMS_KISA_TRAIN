# === 대용량 데이터·산출물 (커밋 금지) ===
data/
model/
runs/
dumps/
feats/
# 폴더째(results/)가 아니라 내용만 무시한다. 폴더를 무시하면 git 이 안으로 들어가지 않아
# 아래 예외가 먹지 않는다.
results/*
# 모델 계보는 예외. 운영 가중치가 무슨 데이터로 학습됐는지의 유일한 기록이라
# 서버 디스크에만 두면 안 된다(runs/ logs/ 는 용량 때문에 제외한 채로 둔다).
!results/MODELS.json
!results/BASELINE.json
!results/SUMMARY.md
weights/
logs/

# === 캐시·가상환경 ===
__pycache__/
*.pyc
.venv/
venv/
work/

# === 대시보드 생성 캐시·로그 ===
dash_v2/dash_meta.json
dash_v2/dataset_meta.json
dash_v2/*.log

# === 가중치·미디어·압축 (코드 트리에 섞여도 무시) ===
*.pt
*.pth
*.onnx
*.engine
*.npz
*.npy
*.mp4
*.jpg
*.jpeg
*.png
*.zip
*.z[0-9]*
*.ts
*.log
*.tmp

# === 비밀·자격증명 (절대 커밋 금지) ===
*.key
*_key
.env
*.env
kaggle.json
.aihub_key
sftp_profiles.json
go2rtc.yaml
_exp/
dash_v2/__pycache__/
scripts/__pycache__/
dash_v2/_cache/
data/학습데이터/손라벨/_backup/
# _kisa_port 는 일회성 탐색 스크립트·가중치가 섞인 작업 공간이라 통째로 제외한다.
# 다만 인증 제출 도구(kisa_items.py)는 무엇을 제출했는지 증명해야 하므로 추적한다.
_kisa_port/*
!_kisa_port/tools/
_kisa_port/tools/*
!_kisa_port/tools/*.py
# 예외는 파일명이 아니라 확장자로 건다. 이름으로 걸면 도구에 파일을 더할 때마다
# 조용히 추적 밖으로 빠진다(rtsp_source.py 가 실제로 그랬다).

# 편집 중 만든 백업 사본(코드·설정·가중치). 이력은 git 에 있다
*.bak
*.bak_*
